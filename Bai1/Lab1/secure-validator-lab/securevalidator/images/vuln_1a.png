<!DOCTYPE html>
<!-- saved from url=(0022)http://127.0.0.1:5000/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <title>SecureValidator</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./vuln_1a_files/pico.min.css">
    <style>
        body {margin:auto; max-width:720px;}
        h1 {text-align:center; margin-bottom:2rem;}
        .result-line {font-size:0.9rem; margin: -0.5rem 0 1rem; color:#333;}
        .valid {color:green;}
        .invalid {color:red;}
        code {background:#f3f3f3; padding:0.2rem 0.4rem;
              border-radius:0.3rem; font-size:0.95em;}
    </style>
</head>
<body>
    <main class="container">
        <h1>SecureValidator</h1>
        <form method="POST">
            <label>Email:
                <input type="text" name="email" placeholder="you@example.com" value="user@exam..ple.com">
                
                    <div class="result-line valid">
                        Email hợp lệ
                    </div>
                
            </label>

            <label>URL:
                <input type="text" name="url" placeholder="https://example.com" value="http://169.254.169.254/latest/meta-data/">
                
                    <div class="result-line valid">
                        URL hợp lệ
                    </div>
                
            </label>

            <label>Filename:
                <input type="text" name="filename" placeholder="file.txt" value=".">
                
                    <div class="result-line valid">
                        Tên file hợp lệ
                    </div>
                
            </label>

            <label>SQL Input:
                <input type="text" name="sql" placeholder="input SQL..." value="CHAR()">
                
                    <div class="result-line"><strong>Đã lọc:</strong>
                        <code>CHAR()</code></div>
                
            </label>

            <label>HTML Input:
                <input type="text" name="html" placeholder="&lt;script&gt;alert(1)&lt;/script&gt;" value="javascript:alert(1)">
                
                    <div class="result-line"><strong>Đã mã hóa:</strong>
                        <code>javascript:alert(1)</code></div>
                
            </label>

            <button type="submit">Xác thực ngay</button>
        </form>
    </main>

</body></html>